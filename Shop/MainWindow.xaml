<Window x:Class="Shop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Shop.Views"
        Title="Shop Manager" Height="600" Width="900"
        WindowState="Maximized">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Боковое -->
            <ColumnDefinition Width="*"/>
            <!-- право-->
        </Grid.ColumnDefinitions>

        <!-- менюха -->
        <Border Grid.Column="0" Background="DarkSlateGray">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Шапка с именем  -->
                <Border Grid.Row="0" Background="DarkGray" Height="60">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Пользователь" 
                                   Foreground="White" 
                                   FontSize="16"
                                   FontWeight="Bold" Height="25"/>
                        <TextBlock Text="{Binding CurrentUser.FullName}" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                        <TextBlock Text="{Binding CurrentUser.Role.Name}" 
                                   Foreground="LightGray" 
                                   FontSize="12"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Кнопки меню -->
                <StackPanel Grid.Row="1">
                    <Button Content="Касса" 
                            Height="50"
                            Margin="10"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Sale">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Sale">
                                        <Setter Property="Background" Value="SkyBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Возвраты" 
                            Height="50"
                            Margin="10"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Returns">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Returns">
                                        <Setter Property="Background" Value="SkyBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Товары" 
                            Height="50"
                            Margin="10"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Products"
                            Visibility="{Binding CanManageProducts}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Products">
                                        <Setter Property="Background" Value="SkyBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Поставки" 
                            Height="50"
                            Margin="10"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Supplies"
                            Visibility="{Binding CanManageSupplies}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Supplies">
                                        <Setter Property="Background" Value="SkyBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Карты лояльности" 
                            Height="50"
                            Margin="10"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Loyalty"
                            Visibility="{Binding CanManageLoyalty}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Loyalty">
                                        <Setter Property="Background" Value="SkyBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Отчёты" 
                            Height="50"
                            Margin="10"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Reports"
                            Visibility="{Binding CanViewReports}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection}" Value="Reports">
                                        <Setter Property="Background" Value="SkyBlue"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Button Grid.Row="2"
                        Content="Выход" 
                        Height="50"
                        Margin="10"
                        Command="{Binding LogoutCommand}"
                        Background="Red"
                        Foreground="White"/>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="LightGray">
            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>