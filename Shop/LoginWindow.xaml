<Window x:Class="Shop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="280" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин:" FontWeight="Bold"/>
        <TextBox Grid.Row="2" Height="25" Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Text="Пароль:" FontWeight="Bold"/>
        <PasswordBox x:Name="pwdBox" Grid.Row="6" Height="25"/>

        <TextBlock Grid.Row="7" Text="{Binding ErrorMessage}" Foreground="Red" 
                   HorizontalAlignment="Center" Margin="0,10,0,0"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Войти" Width="80" Height="30" Margin="0,0,10,0" 
                    Command="{Binding LoginCommand}" 
                    CommandParameter="{Binding ElementName=pwdBox}"/>
            <Button Content="Отмена" Width="80" Height="30" 
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>