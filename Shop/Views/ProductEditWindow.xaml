<Window x:Class="Shop.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар (Заглушка)" 
        Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Окно добавления/редактирования товара будет здесь." 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   FontSize="16" 
                   TextWrapping="Wrap" 
                   TextAlignment="Center"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="100" Click="CancelButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>