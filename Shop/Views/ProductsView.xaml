<UserControl x:Class="Shop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:core="clr-namespace:Shop.Core"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <core:ArticleToImageConverter x:Key="ArticleToImageConverter"/>

        <!-- Стили для кнопок -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="AliceBlue"/>
            <Setter Property="BorderBrush" Value="LightBlue"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightSkyBlue"/>
                </Trigger>
            </Style.Triggers>
        </Style>

      
        <Style x:Key="CenterCellStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: поиск и фильтры -->
        <Border Grid.Row="0" Background="WhiteSmoke" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="250" Margin="0,0,10,0" 
                         VerticalContentAlignment="Center"
                         Padding="5"
                         BorderBrush="LightBlue"
                         ToolTip="Поиск по названию или артикулу"/>
                <Button Content="Поиск" Command="{Binding SearchCommand}" 
                        Width="90" Style="{StaticResource ModernButton}"/>

                <CheckBox Content="Низкий остаток" IsChecked="{Binding IsLowStockFilter}" 
                          Margin="15,0,10,0" VerticalContentAlignment="Center"/>
                <CheckBox Content="Истекает срок" IsChecked="{Binding IsExpiringSoonFilter}" 
                          Margin="0,0,10,0" VerticalContentAlignment="Center"/>

                <Button Content="Применить фильтры" Command="{Binding ApplyFiltersCommand}" 
                        Width="140" Style="{StaticResource ModernButton}"/>

                <Button Content="Применить уценку" Command="{Binding ApplyDiscountCommand}" 
                        Width="150" Style="{StaticResource ModernButton}"/>
            </StackPanel>
        </Border>

      
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Products}" 
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  BorderBrush="LightGray"
                  Background="GhostWhite"
                  RowBackground="White"
                  AlternatingRowBackground="WhiteSmoke"
                  GridLinesVisibility="None"
                  HeadersVisibility="None"
                  Padding="0,5">

            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    
                                    <ColumnDefinition Width="200"/>
                                   
                                    <ColumnDefinition Width="*"/>
                                   
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="130" Height="130" 
                                        BorderBrush="LightGray" BorderThickness="1" 
                                        CornerRadius="5" Margin="0,0,20,0" Background="White">
                                    <Image Source="{Binding Article, Converter={StaticResource ArticleToImageConverter}}" 
                                           Stretch="Uniform" Margin="5"/>
                                </Border>

                              
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="16" FontWeight="Bold" 
                                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding Article, StringFormat='Артикул: {0}'}" 
                                               Foreground="Gray" FontSize="13" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Price, StringFormat='Цена: {0:0.00} ₽'}" 
                                               FontWeight="Bold" Foreground="ForestGreen" FontSize="15" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding NearestExpiryDate, StringFormat='Срок годности: {0:dd.MM.yyyy}'}" 
                                               Foreground="Firebrick" FontSize="13"/>
                                </StackPanel>

                                
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Партии товара:" FontWeight="Bold" Foreground="DimGray" Margin="0,0,0,5"/>

                                   
                                    <DataGrid ItemsSource="{Binding SupplyItems}" 
                                              Width="600"
                                              HorizontalAlignment="Left"
                                              AutoGenerateColumns="False" 
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              MaxHeight="150"
                                              Background="White"
                                              BorderBrush="LightGray"
                                              BorderThickness="1"
                                              GridLinesVisibility="All"
                                              HorizontalGridLinesBrush="LightGray"
                                              VerticalGridLinesBrush="LightGray"
                                              HeadersVisibility="Column"
                                              FontSize="12"
                                              ColumnHeaderHeight="28"
                                              RowHeight="24">

                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*" ElementStyle="{StaticResource CenterCellStyle}"/>
                                            <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="*" ElementStyle="{StaticResource CenterCellStyle}"/>
                                            <DataGridTextColumn Header="Остаток" Binding="{Binding QuantityRemain}" Width="*" ElementStyle="{StaticResource CenterCellStyle}"/>
                                            <DataGridTextColumn Header="Закупочная" Binding="{Binding Cost, StringFormat={}{0:0.00} ₽}" Width="*" ElementStyle="{StaticResource CenterCellStyle}"/>
                                            <DataGridTextColumn Header="Со скидкой" Binding="{Binding DiscountedPrice, StringFormat={}{0:0.00} ₽}" Width="*" ElementStyle="{StaticResource CenterCellStyle}"/>
                                            <DataGridTextColumn Header="Срок годности" Binding="{Binding ExpiryDate, StringFormat={}{0:dd.MM.yyyy}}" Width="*" ElementStyle="{StaticResource CenterCellStyle}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
            <Button Content="Добавить" Command="{Binding AddProductCommand}" 
                    Width="120" Style="{StaticResource ModernButton}"/>
            <Button Content="Редактировать" Command="{Binding EditProductCommand}" 
                    Width="140" Style="{StaticResource ModernButton}"/>
            <Button Content="Удалить" Command="{Binding DeleteProductCommand}" 
                    Width="100" Background="MistyRose" BorderBrush="LightCoral" Style="{StaticResource ModernButton}"/>
        </StackPanel>
    </Grid>
</UserControl>