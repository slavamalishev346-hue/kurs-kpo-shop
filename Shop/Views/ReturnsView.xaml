<UserControl x:Class="Shop.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="White">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка + поиск -->
        <Border Background="LightGray" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="↩ Возвраты товара" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="🔎 Поиск по номеру чека" Margin="0,0,0,5"/>
                <TextBox Height="30" FontSize="14"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding Message}" Foreground="Gray" Margin="0,0,0,10"/>

        <!-- Слева чеки, справа состав -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Sales}"
                      SelectedItem="{Binding SelectedSale}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      Margin="0,0,15,0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="Дата и время" Binding="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="К оплате" Binding="{Binding FinalAmount, StringFormat={}{0:0.00} ₽}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Состав чека №" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSale.Id}" FontSize="16" FontWeight="Bold" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Сумма: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSale.TotalAmount, StringFormat={}{0:0.00} ₽}" Margin="0,0,15,0"/>
                    <TextBlock Text="Скидка: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSale.DiscountAmount, StringFormat={}{0:0.00} ₽}" Margin="0,0,15,0"/>
                    <TextBlock Text="К оплате: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedSale.FinalAmount, StringFormat={}{0:0.00} ₽}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding SaleItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Height="350">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding PriceAtSale, StringFormat={}{0:0.00}}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Куплено" Binding="{Binding Quantity}" Width="65" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Возвращено" Binding="{Binding AlreadyReturned}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Доступно" Binding="{Binding AvailableToReturn}" Width="65" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Вернуть, шт" Width="80"
                                            Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTemplateColumn Header="Возврат" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="−" Width="32" Height="26"
                                                Command="{Binding DataContext.MinusReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="+" Width="32" Height="26"
                                                Command="{Binding DataContext.PlusReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="всё" Width="45" Height="26"
                                                Command="{Binding DataContext.AllReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                    <TextBlock Text="К возврату: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RefundAmount, StringFormat={}{0:0.00} ₽}"
                               FontSize="16" FontWeight="Bold" Foreground="DarkRed" VerticalAlignment="Center"/>
                    <Button Content="Оформить возврат" Width="160" Height="35" Margin="30,0,0,0"
                            Background="DarkRed" Foreground="White" FontWeight="Bold"
                            Command="{Binding ProcessReturnCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>